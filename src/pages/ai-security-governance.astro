---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import EntryPathway from "../components/EntryPathway.astro";
import FAQSection from "../components/FAQSection.astro";
import CTASection from "../components/CTASection.astro";

const description =
  "SeaVic helps organizations make AI use visible, secure, accountable and auditable through governance design, risk assessment and control implementation.";

const faqs = [
  {
    question: "Is this a software implementation page?",
    answer:
      "No. SeaVic leads with advisory, governance design, risk assessment, control implementation and executive interpretation. Technology may support delivery only where approved and useful."
  },
  {
    question: "Does SeaVic provide legal or regulatory certification?",
    answer:
      "No. SeaVic helps organizations build evidence, controls and governance discipline; legal, regulatory and formal compliance conclusions require appropriate counsel and approved evidence."
  }
];
---

<BaseLayout title="AI Security and Governance" description={description} path="/ai-security-governance/">
  <Breadcrumbs items={[{ label: "AI Security and Governance", href: "/ai-security-governance/" }]} />
  <Hero
    eyebrow="Secure"
    title="AI Security and Governance."
    lead="SeaVic helps organizations make AI use visible, secure, accountable and auditable through governance design, risk assessment, control implementation and validated partner-enabled capabilities."
    showVisual={false}
  />

  <section class="section">
    <div class="container grid grid--3">
      {[
        ["Client conditions", "AI tools are spreading faster than policies, ownership and security review can keep up."],
        ["What SeaVic assesses", "AI use, risk triggers, decision rights, control gaps, evidence needs and readiness for accountable scale."],
        ["Operating model", "Governance structure, roles, controls, intake, escalation and remediation disciplines."]
      ].map(([title, copy]) => (
        <article class="card"><div class="card__body"><h3>{title}</h3><p>{copy}</p></div></article>
      ))}
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHeading
        eyebrow="Readiness connection"
        title="From visibility to auditable operating control."
        lead="Security and governance work connects into the approved assessment pathway so findings become executive decisions, remediation actions and recurring management routines."
      />
      <EntryPathway />
    </div>
  </section>

  <section class="section">
    <div class="container two-column">
      <SectionHeading
        eyebrow="Outcomes and deliverables"
        title="Practical evidence for leaders, risk owners and operating teams."
      />
      <ul class="list-clean">
        <li>AI exposure and ownership map.</li>
        <li>Risk and control matrix.</li>
        <li>Governance roles and decision-rights model.</li>
        <li>Prioritized remediation roadmap.</li>
        <li>Executive readout and next-step pathway.</li>
      </ul>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHeading title="Common questions" />
      <FAQSection items={faqs} />
    </div>
  </section>

  <CTASection />
</BaseLayout>
