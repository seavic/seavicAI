---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import EntryPathway from "../components/EntryPathway.astro";
import FAQSection from "../components/FAQSection.astro";
import CTASection from "../components/CTASection.astro";

const description =
  "SeaVic helps organizations make AI use visible, assess security exposure and turn partner-enabled findings into practical governance and remediation actions.";

const faqs = [
  {
    question: "Is partner technology separate from SeaVic services?",
    answer:
      "No. Partner-provided technology is treated separately from SeaVic consulting services and Kosmoy technology. SeaVic focuses on advisory, interpretation, remediation planning and governance services."
  },
  {
    question: "Does SeaVic provide legal, regulatory or product certification?",
    answer:
      "No. SeaVic helps organizations build evidence, controls and governance discipline. Legal, regulatory, formal audit and product certification conclusions require appropriate specialists and approved evidence."
  }
];
---

<BaseLayout title="AI Security and Governance Solutions" description={description} path="/ai-security-governance/">
  <Breadcrumbs items={[{ label: "AI Security and Governance Solutions", href: "/ai-security-governance/" }]} />
  <Hero
    eyebrow="Secure"
    title="AI Security and Governance Solutions."
    lead="SeaVic helps organizations make AI use visible, assess security exposure and turn partner-enabled findings into practical governance and remediation actions."
    showVisual={false}
  />

  <section class="section">
    <div class="container grid grid--3">
      {[
        ["Client conditions", "AI tools are spreading faster than policies, ownership and security review can keep up."],
        ["Security visibility", "Review AI application use, sensitive-data exposure, data-loss risks and security posture where validated partner evidence is available."],
        ["SeaVic role", "Interpret findings, advise leaders, design governance controls and plan remediation while keeping partner technology separate from SeaVic advisory services."]
      ].map(([title, copy]) => (
        <article class="card"><div class="card__body"><h3>{title}</h3><p>{copy}</p></div></article>
      ))}
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHeading
        eyebrow="Responsibility model"
        title="Technology findings still need executive interpretation and governance action."
        lead="SeaVic separates advisory services from partner-provided technology, then helps leaders turn visibility, risk findings and remediation needs into accountable decisions."
      />
      <EntryPathway />
    </div>
  </section>

  <section class="section">
    <div class="container two-column">
      <SectionHeading
        eyebrow="Outcomes and deliverables"
        title="Practical evidence for leaders, risk owners and operating teams."
      />
      <ul class="list-clean">
        <li>AI exposure and ownership map.</li>
        <li>Security visibility and sensitive-data exposure review.</li>
        <li>Risk and control matrix.</li>
        <li>Prioritized remediation roadmap.</li>
        <li>Executive readout and governance action plan.</li>
      </ul>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHeading title="Common questions" />
      <FAQSection items={faqs} />
    </div>
  </section>

  <CTASection />
</BaseLayout>
