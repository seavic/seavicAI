---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CTASection from "../components/CTASection.astro";
import { values } from "../data/content";

const description =
  "SeaVic Consulting is a senior-led boutique consultancy focused on AI governance, security, cost and value governance, AI management and transformation.";
---

<BaseLayout title="About SeaVic Consulting" description={description} path="/about/">
  <Breadcrumbs items={[{ label: "About", href: "/about/" }]} />
  <Hero
    eyebrow="About"
    title="Senior-led AI Governance and Management Advisory."
    lead="SeaVic Consulting is a senior-led boutique consultancy focused on AI governance, AI security, AI cost and value governance, AI management and AI transformation. We help mid-market and regulated organizations gain control of enterprise AI by connecting executive strategy, security visibility, platform-enabled management, accountability, cost, business value, workflow redesign and implementation discipline."
    showVisual={false}
  />

  <section class="section">
    <div class="container grid grid--2">
      <article class="card">
        <div class="card__body">
          <h3>Lui Sieh</h3>
          <p>Senior digital and AI transformation leader with experience connecting strategy, operating models, technology delivery, governance and organizational change. Final biography and proof points require Lui's approval.</p>
        </div>
      </article>
      <article class="card">
        <div class="card__body">
          <h3>Victor Gan</h3>
          <p>Senior technology, security and consulting leader with experience in enterprise solutions, delivery, partnerships and regional market development. Final biography and proof points require Victor's approval.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container two-column">
      <SectionHeading
        eyebrow="Model"
        title="Boutique, practical and client-first."
        lead="SeaVic is vendor-aware and platform-enabled, but client outcomes and governance discipline come first. Kosmoy and partner capabilities support the model where useful, while targeted geography and partnership claims remain controlled until approved."
      />
      <div class="grid">
        {values.map((value) => (
          <article class="card"><div class="card__body"><h3>{value}</h3></div></article>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
