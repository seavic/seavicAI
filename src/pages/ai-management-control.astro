---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import EntryPathway from "../components/EntryPathway.astro";
import FAQSection from "../components/FAQSection.astro";
import CTASection from "../components/CTASection.astro";

const description =
  "Kosmoy is SeaVic's AI management operating layer for cost and usage visibility, ownership, accountability, risk and action tracking, business-value measurement and executive dashboards.";

const faqs = [
  {
    question: "What is Kosmoy?",
    answer:
      "Kosmoy is SeaVic's AI management operating layer for platform-enabled assessments, implementation and executive management routines."
  },
  {
    question: "Does Kosmoy replace governance advisory?",
    answer:
      "No. Kosmoy supports management visibility and evidence, while SeaVic advisory services help leaders define governance, ownership, risk decisions, actions and operating routines."
  }
];
---

<BaseLayout title="Kosmoy AI Management Platform" description={description} path="/ai-management-control/">
  <Breadcrumbs items={[{ label: "Kosmoy AI Management Platform", href: "/ai-management-control/" }]} />
  <Hero
    eyebrow="Manage"
    title="Kosmoy AI Management Platform."
    lead="Kosmoy is SeaVic's AI management operating layer for cost and usage visibility, ownership, accountability, risk and action tracking, business-value measurement and executive dashboards."
    showVisual={true}
  />

  <section class="section">
    <div class="container grid grid--3">
      {[
        ["Management operating layer", "Create a structured view of AI initiatives, workflows, owners, actions and executive decision needs."],
        ["Cost and usage visibility", "Connect spend, usage, allocation and business-value evidence to governance and investment decisions."],
        ["Risk and action tracking", "Track risk, remediation, exceptions and optimization actions so AI management becomes recurring."]
      ].map(([title, copy]) => (
        <article class="card"><div class="card__body"><h3>{title}</h3><p>{copy}</p></div></article>
      ))}
    </div>
  </section>

  <section class="section section--tint">
    <div class="container two-column">
      <SectionHeading
        eyebrow="Executive reporting"
        title="Move from scattered AI activity to a management operating layer."
        lead="SeaVic uses Kosmoy to support recurring visibility across ownership, cost, usage, risk, actions, value and executive dashboards."
      />
      <div class="visual-panel">
        <div class="control-map">
          <div class="control-map__row"><div class="control-map__label">Portfolio</div><div class="control-map__value">Initiatives, tools, workflows and owners</div></div>
          <div class="control-map__row"><div class="control-map__label">Economics</div><div class="control-map__value">Cost, usage, value and thresholds</div></div>
          <div class="control-map__row"><div class="control-map__label">Actions</div><div class="control-map__value">Risks, exceptions, decisions and evidence</div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Engagement pathway"
        title="A management platform starts with visibility and accountability."
      />
      <EntryPathway />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHeading title="Common questions" />
      <FAQSection items={faqs} />
    </div>
  </section>

  <CTASection />
</BaseLayout>
