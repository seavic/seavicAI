---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { siteConfig } from "../data/siteConfig";

const description = "Website Terms shell for SeaVic Consulting LLC.";
---

<BaseLayout title="Website Terms" description={description} path="/terms/">
  <Breadcrumbs items={[{ label: "Website Terms", href: "/terms/" }]} />
  <section class="section">
    <div class="container legal-page">
      <p class="eyebrow">Legal shell</p>
      <h1>Website Terms</h1>
      <p class="lead">This page is a structured shell for {siteConfig.legalName}. Final legal text requires founder and counsel review before publication.</p>
      <h2>Use of This Website</h2>
      <p>Website content is provided for general informational purposes and should not be treated as legal, regulatory, security or compliance advice.</p>
      <h2>Intellectual Property</h2>
      <p>SeaVic Consulting LLC owns or controls the website content except where third-party rights are expressly identified.</p>
      <h2>External Links</h2>
      <p>External links may be provided for convenience and do not imply endorsement unless expressly approved.</p>
      <h2>Limitations and Disclaimers</h2>
      <p>Final limitation language requires founder and counsel approval before public launch.</p>
      <h2>Contact</h2>
      <p><a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page {
    max-width: 840px;
  }

  .legal-page h2 {
    margin-top: 2rem;
    font-size: 1.5rem;
  }
</style>
