---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import EntryPathway from "../components/EntryPathway.astro";
import FAQSection from "../components/FAQSection.astro";
import CTASection from "../components/CTASection.astro";

const description =
  "SeaVic supports recurring AI governance routines across monitoring, reporting, cost and usage reviews, risk and exception management and optimization.";

const faqs = [
  {
    question: "Is managed governance a one-time assessment?",
    answer:
      "No. Managed governance is designed as a recurring operating rhythm after initial diagnostic, readiness or implementation work has clarified ownership, controls and reporting needs."
  },
  {
    question: "Does managed governance replace internal accountability?",
    answer:
      "No. SeaVic supports governance routines and executive evidence, while client leaders retain decision rights, accountability and approval authority."
  }
];
---

<BaseLayout title="Managed AI Governance Services" description={description} path="/managed-ai-governance-services/">
  <Breadcrumbs items={[{ label: "Managed AI Governance Services", href: "/managed-ai-governance-services/" }]} />
  <Hero
    eyebrow="Operate"
    title="Managed AI Governance Services."
    lead="SeaVic supports recurring AI governance routines across monitoring, reporting, cost and usage reviews, risk and exception management and optimization."
    showVisual={false}
  />

  <section class="section">
    <div class="container grid grid--3">
      {[
        ["Governance monitoring", "Maintain a regular view of AI activity, ownership, actions, controls and decision needs."],
        ["Risk and exception management", "Track remediation, exceptions, escalations and evidence so governance does not stall after assessment."],
        ["Executive reporting", "Prepare recurring leadership reporting across security, risk, cost, usage, value and transformation progress."]
      ].map(([title, copy]) => (
        <article class="card"><div class="card__body"><h3>{title}</h3><p>{copy}</p></div></article>
      ))}
    </div>
  </section>

  <section class="section section--tint">
    <div class="container two-column">
      <SectionHeading
        eyebrow="Management rhythm"
        title="AI governance has to keep moving after the first assessment."
        lead="SeaVic helps leaders turn governance decisions into recurring reviews, actions, exceptions and optimization routines."
      />
      <ul class="list-clean">
        <li>Recurring governance review cadence.</li>
        <li>Security and risk review support.</li>
        <li>Cost and usage review support.</li>
        <li>Exception and remediation tracking.</li>
        <li>Executive and board reporting support.</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Engagement pathway" title="Move from implementation into recurring governance." />
      <EntryPathway />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHeading title="Common questions" />
      <FAQSection items={faqs} />
    </div>
  </section>

  <CTASection />
</BaseLayout>
