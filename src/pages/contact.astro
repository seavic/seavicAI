---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Hero from "../components/Hero.astro";
import ContactPanel from "../components/ContactPanel.astro";
import { siteConfig } from "../data/siteConfig";

const description =
  "Contact SeaVic Consulting to discuss enterprise AI governance, security, management and transformation priorities.";
---

<BaseLayout title="Contact SeaVic Consulting" description={description} path="/contact/">
  <Breadcrumbs items={[{ label: "Contact", href: "/contact/" }]} />
  <Hero
    eyebrow="Contact"
    title="Discuss your enterprise AI priorities."
    lead="Start with a focused note about the AI operating issue, governance question or transformation priority you want to clarify."
    showVisual={false}
  />

  <section class="section">
    <div class="container two-column">
      <ContactPanel />
      <div class="visual-panel">
        <h2>Useful context to include</h2>
        <ul class="list-clean">
          <li>Name and company.</li>
          <li>Business email and role.</li>
          <li>Area of interest: security, management, transformation or readiness.</li>
          <li>Brief description of the priority.</li>
        </ul>
        <p>
          Email fallback: <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
