---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import EntryPathway from "../components/EntryPathway.astro";
import FAQSection from "../components/FAQSection.astro";
import CTASection from "../components/CTASection.astro";

const description =
  "SeaVic helps leaders assess AI governance readiness, design policies and standards, clarify operating models and prepare for responsible risk and audit review.";

const faqs = [
  {
    question: "Is this legal or regulatory certification?",
    answer:
      "No. SeaVic helps leaders prepare governance evidence, controls and operating discipline. Formal legal, regulatory or audit conclusions require appropriate counsel, auditors and approved evidence."
  },
  {
    question: "Where does governance advisory fit in the wider model?",
    answer:
      "Governance advisory sets the decision rights, policies, standards and accountability model that security visibility, platform-enabled management and managed governance services can operate against."
  }
];
---

<BaseLayout title="AI Governance, Risk and Compliance Advisory" description={description} path="/ai-governance-risk-compliance-advisory/">
  <Breadcrumbs items={[{ label: "AI Governance, Risk and Compliance Advisory", href: "/ai-governance-risk-compliance-advisory/" }]} />
  <Hero
    eyebrow="Govern"
    title="AI Governance, Risk and Compliance Advisory."
    lead="SeaVic helps leaders assess AI governance readiness, design policies and standards, clarify operating models and prepare for responsible risk and audit review."
    showVisual={false}
  />

  <section class="section">
    <div class="container grid grid--3">
      {[
        ["Readiness assessment", "Evaluate AI governance maturity, risk exposure, current controls, ownership gaps and decision needs."],
        ["Policies and standards", "Define practical AI policies, acceptable-use standards, intake paths, approval boundaries and escalation routines."],
        ["Executive advisory", "Prepare leadership and board-facing evidence for decisions about AI risk, investment, accountability and scale."]
      ].map(([title, copy]) => (
        <article class="card"><div class="card__body"><h3>{title}</h3><p>{copy}</p></div></article>
      ))}
    </div>
  </section>

  <section class="section section--tint">
    <div class="container two-column">
      <SectionHeading
        eyebrow="Operating model"
        title="Governance becomes useful when leaders can operate it."
        lead="SeaVic connects policies, roles, risk decisions, evidence and reporting into a model that can be used by executives and operating teams."
      />
      <ul class="list-clean">
        <li>AI governance readiness assessment.</li>
        <li>Policy and standards roadmap.</li>
        <li>Decision rights and operating model design.</li>
        <li>Risk and control framework alignment.</li>
        <li>Executive and board advisory materials.</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Engagement pathway" title="Start with evidence, then build the control model." />
      <EntryPathway />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHeading title="Common questions" />
      <FAQSection items={faqs} />
    </div>
  </section>

  <CTASection />
</BaseLayout>
