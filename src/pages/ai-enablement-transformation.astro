---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CTASection from "../components/CTASection.astro";
import FAQSection from "../components/FAQSection.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { servicePages } from "../data/content";

const page = servicePages.transformation;
---

<BaseLayout title={page.title} description={page.description} path={page.href}>
  <Breadcrumbs items={[{ label: page.title, href: page.href }]} />
  <Hero eyebrow={page.eyebrow} title={page.heroHeadline} lead={page.description} visualVariant="workflow" size="compact" />

  <section class="section">
    <div class="container two-column">
      <SectionHeading eyebrow="Business problem" title="A promising pilot is not yet an operating model." />
      <div class="stack">
        {page.intro.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container grid grid--3">
      <article class="card"><div class="card__body"><h3>When this becomes a problem</h3><p>{page.problem}</p></div></article>
      <article class="card"><div class="card__body"><h3>What SeaVic does</h3><p>{page.does}</p></div></article>
      <article class="card"><div class="card__body"><h3>What an engagement looks like</h3><p>{page.engagement}</p></div></article>
    </div>
  </section>

  <section class="section">
    <div class="container two-column">
      <SectionHeading eyebrow="Outputs" title="Move from a promising AI idea to a workflow the business can actually operate." />
      <div class="visual-panel">
        <ul class="list-clean output-list">
          {page.outputs.map((output) => <li>{output}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHeading title="Common questions" />
      <FAQSection items={page.faqs} />
    </div>
  </section>

  <CTASection />
</BaseLayout>
