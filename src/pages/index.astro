---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import OfferingCard from "../components/OfferingCard.astro";
import MethodologySteps from "../components/MethodologySteps.astro";
import EntryPathway from "../components/EntryPathway.astro";
import CTASection from "../components/CTASection.astro";
import { executiveQuestions, offerings, outcomes } from "../data/content";

const description =
  "SeaVic Consulting helps mid-market and regulated organizations gain control of enterprise AI through governance advisory, security visibility, platform-enabled management, managed governance and transformation discipline.";
---

<BaseLayout title="Gain Control of Enterprise AI" description={description}>
  <Hero
    eyebrow="AI Governance and Management Advisory"
    title="Gain Control of Enterprise AI."
    lead="Organizations are adopting AI faster than they can govern, secure, fund and manage it. SeaVic connects governance advisory, partner-enabled security visibility, Kosmoy platform-enabled management, managed governance services and transformation discipline so leaders can scale AI with evidence and control."
  />

  <section class="section">
    <div class="container two-column">
      <SectionHeading
        eyebrow="Operating problem"
        title="AI is becoming an operating-capability issue, not a side experiment."
        lead="Leaders need a practical way to see what is being used, where risk sits, who owns decisions, what it costs and whether the business value justifies scaling."
      />
      <div class="visual-panel">
        <div class="control-map">
          {executiveQuestions.map((question) => (
            <div class="control-map__row">
              <div class="control-map__label">Question</div>
              <div class="control-map__value">{question}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHeading
        eyebrow="Offerings"
        title="Govern. Secure. Manage. Operate. Transform."
        lead="SeaVic organizes enterprise AI control through five connected capability areas."
      />
      <div class="service-architecture">
        {offerings.map((offering) => <OfferingCard {...offering} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="How we work"
        title="Diagnose, govern, implement, transform and manage."
        lead="The method connects evidence gathering, decision rights, controls, adoption and recurring executive visibility."
      />
      <MethodologySteps />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHeading
        eyebrow="Entry pathway"
        title="Start narrow, then scale the operating model."
        lead="The pathway begins with an AI Control Diagnostic and can expand into governance readiness, security visibility, platform-enabled management, managed governance and transformation support."
      />
      <EntryPathway />
    </div>
  </section>

  <section class="section">
    <div class="container two-column">
      <SectionHeading
        eyebrow="Business outcomes"
        title="Control that supports responsible scale."
        lead="SeaVic is built for leaders who need enterprise AI to become visible, accountable and measurable."
      />
      <ul class="list-clean">
        {outcomes.map((outcome) => <li>{outcome}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container two-column">
      <SectionHeading
        eyebrow="Senior-led model"
        title="Built by experienced technology and transformation leaders."
        lead="SeaVic Consulting is a senior-led boutique advisory firm connecting executive strategy, AI governance, security visibility, Kosmoy platform-enabled management, accountability, cost, business value, workflow redesign and implementation discipline."
      />
      <div class="grid">
        <article class="card">
          <div class="card__body">
            <h3>Lui Sieh</h3>
            <p>Senior digital and AI transformation leader connecting strategy, operating models, technology delivery, governance and organizational change.</p>
          </div>
        </article>
        <article class="card">
          <div class="card__body">
            <h3>Victor Gan</h3>
            <p>Senior technology, security and consulting leader with experience in enterprise solutions, delivery, partnerships and regional market development.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .service-architecture {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 1180px) {
    .service-architecture {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .service-architecture {
      grid-template-columns: 1fr;
    }
  }
</style>
