---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTASection from "../../components/CTASection.astro";
import EntryPathway from "../../components/EntryPathway.astro";
import MethodologySteps from "../../components/MethodologySteps.astro";
import OfferingCard from "../../components/OfferingCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { executiveQuestions, offerings, outcomes } from "../../data/content";
import { localPath } from "../../lib/urls";

const description =
  "SeaVic Consulting helps mid-market and regulated organizations gain control of enterprise AI through governance, security, accountability, cost, value and transformation discipline.";
---

<BaseLayout
  title="Gain Control of Enterprise AI"
  description={description}
  path="/concepts/consulting-professional-services/"
  noindex={true}
>
  <section class="concept-hero concept-hero--consulting">
    <div class="container concept-hero__grid">
      <div class="concept-hero__copy">
        <p class="eyebrow">AI Governance and Management Advisory</p>
        <h1>Gain Control of Enterprise AI.</h1>
        <p class="lead">
          Organizations are adopting AI faster than they can control, secure, fund and manage it. SeaVic connects governance, security, accountability, cost, value and transformation so leaders can scale AI with evidence and control.
        </p>
        <div class="button-row">
          <a class="button" href={localPath("/contact/")}>Discuss Your Enterprise AI Priorities</a>
          <a class="button button--secondary" href={localPath("/how-we-work/")}>Assess Your AI Operating Readiness</a>
        </div>
      </div>
      <div class="consulting-brief visual-panel" aria-label="Enterprise AI control model diagram">
        <div class="control-map">
          <div class="control-map__row">
            <div class="control-map__label">Exposure</div>
            <div class="control-map__value">AI use, tools, models and workflows</div>
          </div>
          <div class="control-map__row">
            <div class="control-map__label">Risk</div>
            <div class="control-map__value">Security, privacy, regulatory and operational impact</div>
          </div>
          <div class="control-map__row">
            <div class="control-map__label">Owners</div>
            <div class="control-map__value">Decision rights, approvals and remediation</div>
          </div>
          <div class="control-map__row">
            <div class="control-map__label">Value</div>
            <div class="control-map__value">Cost, outcome evidence and scale decisions</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container consulting-split">
      <SectionHeading
        eyebrow="Operating problem"
        title="AI is becoming an operating-capability issue, not a side experiment."
        lead="Leaders need a practical way to see what is being used, where risk sits, who owns decisions, what it costs and whether the business value justifies scaling."
      />
      <div class="visual-panel">
        <div class="control-map">
          {executiveQuestions.map((question) => (
            <div class="control-map__row">
              <div class="control-map__label">Question</div>
              <div class="control-map__value">{question}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint consulting-offerings">
    <div class="container">
      <SectionHeading
        eyebrow="Offerings"
        title="Secure. Manage. Transform."
        lead="SeaVic organizes enterprise AI control through three connected offering areas."
      />
      <div class="grid grid--3">
        {offerings.map((offering) => <OfferingCard {...offering} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="How we work"
        title="Diagnose, govern, implement, transform and manage."
        lead="The method connects evidence gathering, decision rights, controls, adoption and recurring executive visibility."
      />
      <MethodologySteps />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHeading
        eyebrow="Entry pathway"
        title="Start narrow, then scale the operating model."
        lead="The approved pathway begins with an AI Control Diagnostic and can expand into comprehensive readiness, implementation and managed governance."
      />
      <EntryPathway />
    </div>
  </section>

  <section class="section">
    <div class="container consulting-split">
      <SectionHeading
        eyebrow="Business outcomes"
        title="Control that supports responsible scale."
        lead="SeaVic is built for leaders who need enterprise AI to become visible, accountable and measurable."
      />
      <ul class="list-clean outcome-list">
        {outcomes.map((outcome) => <li>{outcome}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container consulting-split">
      <SectionHeading
        eyebrow="Senior-led model"
        title="Built by experienced technology and transformation leaders."
        lead="SeaVic Consulting is a senior-led boutique advisory firm connecting executive strategy, security, governance, accountability, cost, business value, workflow redesign and implementation discipline."
      />
      <div class="founder-grid">
        <article class="card">
          <div class="card__body">
            <h3>Lui Sieh</h3>
            <p>Senior digital and AI transformation leader connecting strategy, operating models, technology delivery, governance and organizational change.</p>
          </div>
        </article>
        <article class="card">
          <div class="card__body">
            <h3>Victor Gan</h3>
            <p>Senior technology, security and consulting leader with experience in enterprise solutions, delivery, partnerships and regional market development.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .concept-hero {
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .concept-hero--consulting {
    background:
      linear-gradient(90deg, rgba(14, 148, 147, 0.1), transparent 42%),
      var(--color-white);
  }

  .concept-hero__grid,
  .consulting-split {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: center;
  }

  .concept-hero__copy {
    max-width: 900px;
  }

  .concept-hero__copy h1 {
    margin-bottom: 1rem;
  }

  .concept-hero__copy .lead {
    margin-bottom: 1.5rem;
  }

  .consulting-brief {
    border-left: 6px solid var(--color-teal);
  }

  .consulting-offerings :global(.card) {
    border-top: 5px solid var(--color-teal);
  }

  .outcome-list {
    display: grid;
    gap: 0.85rem;
  }

  .outcome-list li {
    padding: 1rem;
    border-left: 5px solid var(--color-teal);
    background: var(--color-white);
  }

  .founder-grid {
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 920px) {
    .concept-hero__grid,
    .consulting-split {
      grid-template-columns: 1fr;
    }
  }
</style>
