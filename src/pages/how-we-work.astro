---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CTASection from "../components/CTASection.astro";
import FAQSection from "../components/FAQSection.astro";
import Hero from "../components/Hero.astro";
import MethodologySteps from "../components/MethodologySteps.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { globalFaqs } from "../data/content";

const description =
  "SeaVic works through a practical five-stage pathway from AI control diagnostic through managed AI governance.";
---

<BaseLayout title="Diagnose. Govern. Implement. Transform. Manage." description={description} path="/how-we-work/">
  <Breadcrumbs items={[{ label: "How We Work", href: "/how-we-work/" }]} />
  <Hero
    eyebrow="How We Work"
    title="A practical pathway to managed AI governance."
    lead="SeaVic combines evidence gathering, governance design, implementation discipline, workflow transformation and recurring management support."
    showVisual={false}
    size="compact"
    secondaryHref="/ai-security-governance/"
    secondaryLabel="View Services"
  />

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Engagement pathway"
        title="One connected sequence, from immediate risks to durable oversight."
        lead="Each stage leaves the organization with a clear outcome and prepares the next decision."
      />
      <MethodologySteps />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="principles-heading">
        <SectionHeading
          eyebrow="Principles"
          title="Principles that govern every engagement"
          lead="The work is designed to strengthen executive judgment and durable operating control, not simply introduce more technology."
        />
      </div>
      <div class="grid grid--3">
      {[
        ["Human accountability", "Decision rights, approval boundaries and escalation paths are designed into the operating model."],
        ["Evidence discipline", "Claims, findings and recommendations are tied to reviewable evidence and leadership-ready decisions."],
        ["Technology in service of the client", "Technology may accelerate delivery, but it does not replace advisory judgment or the client relationship."]
      ].map(([title, copy]) => (
        <article class="card"><div class="card__body"><h3>{title}</h3><p>{copy}</p></div></article>
      ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHeading title="Common questions" />
      <FAQSection items={globalFaqs} />
    </div>
  </section>

  <CTASection showSecondary={false} />
</BaseLayout>
