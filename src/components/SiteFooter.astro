---
import { footerNavigation } from "../data/navigation";
import { siteConfig } from "../data/siteConfig";
import { localPath } from "../lib/urls";
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <a class="footer-brand" href={localPath("/")}>
        <img src={localPath("/brand/seavic-ai-consulting-horizontal.svg")} alt="SeavicAI Consulting" width="220" height="64" />
      </a>
      <p>
        Senior-led AI Governance and Management Advisory for enterprises, regulated and risk-sensitive organizations, business units, and selected technology service providers.
      </p>
    </div>
    <nav aria-label="Footer navigation">
      {footerNavigation.map((item) => (
        <a href={localPath(item.href)}>{item.label}</a>
      ))}
    </nav>
    <p class="legal">
      © {siteConfig.copyrightYear} {siteConfig.corporateName}. All rights reserved.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-navy);
    color: var(--color-white);
    padding-block: 2.5rem;
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(180px, 0.5fr) minmax(220px, 0.7fr);
    gap: 2rem;
  }

  .footer-brand {
    display: inline-flex;
    padding: 0.45rem 0.55rem;
    border-radius: var(--radius);
    background: var(--color-white);
    text-decoration: none;
  }

  .footer-brand img {
    width: min(220px, 70vw);
    height: auto;
    display: block;
  }

  .site-footer p {
    max-width: 520px;
    margin-top: 1rem;
    color: #dce8ea;
  }

  .site-footer nav {
    display: grid;
    gap: 0.55rem;
  }

  .site-footer a {
    color: var(--color-white);
  }

  .legal {
    justify-self: end;
    font-size: 0.92rem;
  }

  @media (max-width: 780px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }

    .legal {
      justify-self: start;
    }
  }
</style>
