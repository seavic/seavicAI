---
import { footerNavigation } from "../data/navigation";
import { siteConfig } from "../data/siteConfig";
import { localPath } from "../lib/urls";
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <a class="footer-brand" href={localPath("/")}>
        <span>Seavic<span>AI</span></span>
        <small>CONSULTING</small>
      </a>
      <p>
        Senior-led AI Governance and Management Advisory for mid-market and regulated organizations.
      </p>
    </div>
    <nav aria-label="Footer navigation">
      {footerNavigation.map((item) => (
        <a href={localPath(item.href)}>{item.label}</a>
      ))}
    </nav>
    <p class="legal">
      © {siteConfig.copyrightYear} {siteConfig.legalName}. All rights reserved.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-navy);
    color: var(--color-white);
    padding-block: 2.5rem;
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(180px, 0.5fr) minmax(220px, 0.7fr);
    gap: 2rem;
  }

  .footer-brand {
    display: inline-flex;
    flex-direction: column;
    color: var(--color-white);
    text-decoration: none;
    line-height: 1;
  }

  .footer-brand span {
    font-size: 1.45rem;
    font-weight: 800;
  }

  .footer-brand span span,
  .footer-brand small {
    color: #bde4e8;
  }

  .footer-brand small {
    margin-top: 0.2rem;
    font-weight: 800;
    letter-spacing: 0.22em;
  }

  .site-footer p {
    max-width: 520px;
    margin-top: 1rem;
    color: #dce8ea;
  }

  .site-footer nav {
    display: grid;
    gap: 0.55rem;
  }

  .site-footer a {
    color: var(--color-white);
  }

  .legal {
    justify-self: end;
    font-size: 0.92rem;
  }

  @media (max-width: 780px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }

    .legal {
      justify-self: start;
    }
  }
</style>
