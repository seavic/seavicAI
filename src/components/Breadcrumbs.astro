---
import { localPath } from "../lib/urls";

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs container" aria-label="Breadcrumb">
  <ol>
    <li><a href={localPath("/")}>Home</a></li>
    {items.map((item) => (
      <li><a href={localPath(item.href)}>{item.label}</a></li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    padding-top: 1.1rem;
    font-size: 0.9rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .breadcrumbs li:not(:last-child)::after {
    content: "/";
    margin-left: 0.45rem;
    color: var(--color-gray);
  }
</style>
