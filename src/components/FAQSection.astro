---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  items: FAQ[];
}

const { items } = Astro.props;
---

<div class="faq">
  {items.map((item) => (
    <details>
      <summary>{item.question}</summary>
      <p>{item.answer}</p>
    </details>
  ))}
</div>

<style>
  .faq {
    display: grid;
    gap: 0.75rem;
  }

  .faq details {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
  }

  .faq summary {
    padding: 1rem;
    color: var(--color-navy);
    cursor: pointer;
    font-weight: 800;
  }

  .faq p {
    padding: 0 1rem 1rem;
    margin: 0;
  }
</style>
