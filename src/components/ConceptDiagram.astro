---
interface Props {
  variant:
    | "hero-control"
    | "offerings"
    | "journey"
    | "risk-evidence"
    | "management"
    | "workflow"
    | "about"
    | "contact";
  title?: string;
  tone?: "light" | "dark";
}

const diagrams = {
  "hero-control": ["Fragmented AI use and tools", "Visibility", "Governance", "Control"],
  offerings: ["Secure", "Manage", "Transform"],
  journey: ["Diagnose", "Govern", "Implement", "Transform", "Manage"],
  "risk-evidence": ["Discover AI use", "Assign ownership", "Test controls", "Produce reviewable evidence"],
  management: ["Register inventory and owner", "Observe usage, cost and risk", "Govern policy and decision rights", "Control approvals and limits"],
  workflow: ["Map current workflow", "Design AI-supported work", "Set human approval and exception boundaries", "Measure operating outcome"],
  about: ["Strategy", "Security", "Governance", "Transformation"],
  contact: ["Share the operating issue", "Clarify the leadership decision", "Agree a useful next step"]
} as const;

const { variant, title = "Conceptual operating-model diagram", tone = "light" } = Astro.props;
const steps = diagrams[variant];
---

<figure class={`concept concept--${variant} ${tone === "dark" ? "concept--on-dark" : ""}`} aria-labelledby={`${variant}-diagram-title`}>
  <figcaption id={`${variant}-diagram-title`} class="sr-only">{title}</figcaption>
  <div class="concept__desktop-art" aria-hidden="true">
    {variant === "hero-control" && (
      <svg viewBox="0 0 1000 440" focusable="false">
        <path class="signal" d="M92 106C260 46 390 102 536 198M104 220C280 220 396 216 536 216M96 326C256 390 408 306 536 234" />
        <circle class="source-dot" cx="106" cy="104" r="10" /><circle class="source-dot" cx="184" cy="152" r="7" /><circle class="source-dot" cx="144" cy="272" r="8" /><circle class="source-dot" cx="246" cy="318" r="10" /><circle class="source-dot" cx="312" cy="114" r="8" /><circle class="source-dot" cx="360" cy="254" r="7" />
        <rect class="source-box" x="70" y="70" width="72" height="72" rx="12" /><path class="source-mark" d="M91 106h30M106 91v30" />
        <rect class="source-box" x="204" y="282" width="72" height="72" rx="12" /><path class="source-mark" d="M224 330l12-18 18 18" />
        <circle class="control-halo" cx="650" cy="216" r="122" /><circle class="control-ring" cx="650" cy="216" r="92" /><circle class="control-ring-inner" cx="650" cy="216" r="64" /><circle class="control-core" cx="650" cy="216" r="16" />
        <path class="outcome-rail" d="M780 216H884M884 116v204M884 116h36M884 184h36M884 252h36M884 320h36" />
        <text class="label label--light" x="98" y="404">Fragmented AI use and tools</text><text class="label label--light" x="572" y="404">Visibility · Governance · Control</text>
        <text class="callout label--light" x="930" y="122">Reduce risk</text><text class="callout label--light" x="930" y="190">Build accountability</text><text class="callout label--light" x="930" y="258">Strengthen governance</text><text class="callout label--light" x="930" y="326">Drive outcomes</text>
      </svg>
    )}
    {variant === "risk-evidence" && (
      <svg viewBox="0 0 1000 440" focusable="false">
        <path class="track" d="M126 242H820" /><path class="track-arrow" d="M802 222l32 20-32 20" />
        <path class="track-soft" d="M128 270H820" />
        <circle class="node" cx="142" cy="242" r="52" /><path class="node-mark" d="M142 206l27 10v25c0 22-16 36-27 43-11-7-27-21-27-43v-25zM142 226v34" />
        <circle class="node" cx="360" cy="242" r="52" /><path class="node-mark" d="M335 242h50M360 217v50" />
        <circle class="node" cx="578" cy="242" r="52" /><path class="node-mark" d="M554 255l16 16 33-38" />
        <circle class="node node--filled" cx="796" cy="242" r="60" /><path class="node-mark node-mark--paper" d="M772 242h48M796 218v48" />
        <path class="outcome-rail" d="M796 180V128" />
        <rect class="output-card" x="646" y="48" width="300" height="80" rx="14" />
        <text class="output-label" x="796" y="80">Prioritized remediation path</text><text class="output-detail" x="796" y="107">Leadership-ready evidence</text>
        <text class="stage-label" x="142" y="342">Discover<tspan x="142" dy="25">AI use</tspan></text>
        <text class="stage-label" x="360" y="342">Assign<tspan x="360" dy="25">ownership</tspan></text>
        <text class="stage-label" x="578" y="342">Test<tspan x="578" dy="25">controls</tspan></text>
        <text class="stage-label" x="796" y="342">Produce<tspan x="796" dy="25">evidence</tspan></text>
      </svg>
    )}
    {variant === "management" && (
      <svg viewBox="0 0 1000 440" focusable="false">
        <path class="loop-link" d="M280 136H720M800 194V274M720 332H280M200 274V194" />
        <path class="loop-link-arrow" d="M700 116l20 20-20 20M780 254l20 20-20 20M300 312l-20 20 20 20M220 214l-20-20 20-20" />
        <circle class="hub" cx="500" cy="234" r="102" /><circle class="hub-inner" cx="500" cy="234" r="66" /><path class="hub-mark" d="M468 234h64M500 202v64" />
        <circle class="node" cx="220" cy="136" r="58" /><path class="node-mark" d="M196 116h48M196 136h48M196 156h34" />
        <circle class="node" cx="780" cy="136" r="58" /><path class="node-mark" d="M752 136c12-19 44-19 56 0-12 19-44 19-56 0zM780 136h1" />
        <circle class="node" cx="780" cy="332" r="58" /><path class="node-mark" d="M756 338l18 18 34-42" />
        <circle class="node" cx="220" cy="332" r="58" /><path class="node-mark" d="M220 302v60M190 332h60" />
        <text class="stage-label" x="220" y="50">Register<tspan class="stage-detail" x="220" dy="24">inventory and owner</tspan></text>
        <text class="stage-label" x="780" y="50">Observe<tspan class="stage-detail" x="780" dy="24">usage, cost and risk</tspan></text>
        <text class="stage-label" x="780" y="412">Govern<tspan class="stage-detail" x="780" dy="24">policy and decision rights</tspan></text>
        <text class="stage-label" x="220" y="412">Control<tspan class="stage-detail" x="220" dy="24">approvals and limits</tspan></text>
        <text class="center-label" x="500" y="224">Executive AI</text><text class="center-label" x="500" y="252">control plane</text>
      </svg>
    )}
    {variant === "workflow" && (
      <svg viewBox="0 0 1000 440" focusable="false">
        <path class="workflow-line" d="M174 218H312M456 218H548M684 218H810" /><path class="track-arrow" d="M794 198l32 20-32 20" />
        <rect class="workflow-box" x="52" y="144" width="124" height="148" rx="16" /><path class="workflow-mark" d="M86 190h56M86 218h56M86 246h36" />
        <rect class="workflow-box workflow-box--teal" x="312" y="144" width="144" height="148" rx="16" /><path class="workflow-mark workflow-mark--paper" d="M350 232l26-28 20 20 30-38" />
        <path class="approval-gate" d="M556 160h120v116H556zM576 194h80M616 166v102" /><circle class="approval-core" cx="616" cy="218" r="22" />
        <circle class="outcome" cx="858" cy="218" r="72" /><path class="outcome-mark" d="M822 230l23 22 48-54" />
        <text class="workflow-label" x="114" y="346">Map current<tspan x="114" dy="25">workflow</tspan></text>
        <text class="workflow-label" x="384" y="346">Design AI-enabled<tspan x="384" dy="25">work</tspan></text>
        <text class="workflow-label workflow-label--small" x="616" y="346">Set approvals<tspan x="616" dy="23">and exceptions</tspan></text>
        <text class="workflow-label" x="858" y="346">Measure operating<tspan x="858" dy="25">outcome</tspan></text>
      </svg>
    )}
    {variant === "about" && (
      <svg viewBox="0 0 1000 440" focusable="false">
        <path class="loop" d="M292 126C414 42 618 42 740 126C834 192 834 278 740 332C618 404 414 404 292 332C198 278 198 192 292 126Z" />
        <circle class="hub" cx="516" cy="230" r="98" /><circle class="hub-inner" cx="516" cy="230" r="64" /><path class="hub-mark" d="M484 230h64M516 198v64" />
        <circle class="node" cx="304" cy="138" r="44" /><circle class="node" cx="728" cy="138" r="44" /><circle class="node" cx="728" cy="322" r="44" /><circle class="node" cx="304" cy="322" r="44" />
        <text class="label" x="252" y="76">Strategy</text><text class="label" x="678" y="76">Security</text><text class="label" x="660" y="404">Transformation</text><text class="label" x="244" y="404">Governance</text><text class="center-label" x="516" y="237">SeaVic advisory</text>
      </svg>
    )}
    {variant === "contact" && (
      <svg viewBox="0 0 1000 440" focusable="false">
        <path class="track" d="M142 220H836" /><path class="track-arrow" d="M818 200l32 20-32 20" />
        <circle class="node" cx="164" cy="220" r="66" /><path class="node-mark" d="M130 194h68v45h-38l-20 18v-18h-10zM150 216h28M150 232h18" />
        <circle class="node node--filled" cx="500" cy="220" r="72" /><path class="node-mark node-mark--paper" d="M468 190h64v56h-64zM482 206h36M482 224h24" />
        <circle class="outcome" cx="836" cy="220" r="72" /><path class="outcome-mark" d="M800 232l24 22 48-56" />
        <text class="stage-label" x="164" y="338">Share the<tspan x="164" dy="26">operating issue</tspan></text>
        <text class="stage-label" x="500" y="338">Clarify the leadership<tspan x="500" dy="26">decision</tspan></text>
        <text class="stage-label" x="836" y="338">Agree a useful<tspan x="836" dy="26">next step</tspan></text>
      </svg>
    )}
    {!["hero-control", "risk-evidence", "management", "workflow", "about", "contact"].includes(variant) && (
      <svg viewBox="0 0 1000 440" focusable="false">
        <path class="track" d="M150 220H850" /><path class="track-arrow" d="M834 200l32 20-32 20" />
        {steps.map((_, index) => <circle class="node" cx={150 + index * (700 / Math.max(steps.length - 1, 1))} cy="220" r="48" />)}
      </svg>
    )}
  </div>
  <ol class="concept__mobile-summary">
    {steps.map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><span>{step}</span></li>)}
  </ol>
</figure>

<style>
  .concept { margin: 0; min-width: 0; }
  .concept__desktop-art { min-width: 0; }
  .concept__desktop-art svg { width: 100%; height: auto; display: block; overflow: visible; }
  .signal, .track, .track-soft, .loop { fill: none; stroke: var(--color-teal); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 4 9; opacity: 0.78; }
  .track-soft { opacity: 0.38; }
  .track-arrow, .loop-arrow, .loop-link, .loop-link-arrow, .outcome-rail, .workflow-line, .approval-gate { fill: none; stroke: var(--color-teal); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .source-dot, .control-core, .approval-core { fill: var(--color-teal); }
  .source-box, .node, .hub, .workflow-box, .approval-gate { fill: var(--color-white); stroke: var(--color-teal); stroke-width: 3; }
  .source-mark, .node-mark, .hub-mark, .workflow-mark, .outcome-mark { fill: none; stroke: var(--color-teal); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .node--filled, .workflow-box--teal { fill: var(--color-teal); }
  .node-mark--paper, .workflow-mark--paper { stroke: var(--color-white); }
  .control-halo { fill: rgba(8, 131, 141, 0.14); }
  .control-ring { fill: rgba(8, 131, 141, 0.1); stroke: var(--color-teal); stroke-width: 3; }
  .control-ring-inner, .hub-inner { fill: none; stroke: var(--color-teal); stroke-width: 3; }
  .outcome { fill: rgba(8, 131, 141, 0.12); stroke: var(--color-teal); stroke-width: 3; }
  .output-card { fill: rgba(8, 131, 141, 0.12); stroke: var(--color-teal); stroke-width: 3; }
  .label, .callout, .center-label, .stage-label { fill: var(--color-navy); font-family: var(--font-sans); font-size: 23px; font-weight: 800; text-anchor: middle; }
  .callout { font-size: 20px; font-weight: 600; text-anchor: start; }
  .center-label { font-size: 20px; font-weight: 800; }
  .stage-label { font-size: 19px; }
  .stage-detail { font-size: 14px; font-weight: 600; }
  .output-label, .output-detail { fill: var(--color-navy); font-family: var(--font-sans); text-anchor: middle; }
  .output-label { font-size: 20px; font-weight: 800; }
  .output-detail { font-size: 16px; font-weight: 600; }
  .workflow-label { fill: var(--color-navy); font-family: var(--font-sans); font-size: 20px; font-weight: 800; text-anchor: middle; }
  .workflow-label--small { font-size: 18px; }
  .label--light { fill: var(--color-white); }
  .concept--hero-control .signal, .concept--hero-control .outcome-rail { stroke: #79d7db; }
  .concept--hero-control .source-dot, .concept--hero-control .control-core { fill: #79d7db; }
  .concept--hero-control .source-box, .concept--hero-control .control-ring, .concept--hero-control .control-ring-inner { stroke: #79d7db; }
  .concept--hero-control .source-box { fill: rgba(255, 255, 255, 0.06); }
  .concept--hero-control .source-mark { stroke: #79d7db; }
  .concept--hero-control .control-halo { fill: rgba(121, 215, 219, 0.12); }
  .concept--on-dark .signal, .concept--on-dark .track, .concept--on-dark .track-soft, .concept--on-dark .loop, .concept--on-dark .track-arrow, .concept--on-dark .loop-arrow, .concept--on-dark .loop-link, .concept--on-dark .loop-link-arrow, .concept--on-dark .outcome-rail, .concept--on-dark .workflow-line, .concept--on-dark .approval-gate { stroke: #79d7db; }
  .concept--on-dark .source-dot, .concept--on-dark .control-core, .concept--on-dark .approval-core { fill: #79d7db; }
  .concept--on-dark .source-box, .concept--on-dark .node, .concept--on-dark .hub, .concept--on-dark .workflow-box, .concept--on-dark .approval-gate { fill: rgba(255, 255, 255, 0.04); stroke: #79d7db; }
  .concept--on-dark .node--filled, .concept--on-dark .workflow-box--teal { fill: var(--color-teal); }
  .concept--on-dark .source-mark, .concept--on-dark .node-mark, .concept--on-dark .hub-mark, .concept--on-dark .workflow-mark, .concept--on-dark .outcome-mark { stroke: #79d7db; }
  .concept--on-dark .node-mark--paper, .concept--on-dark .workflow-mark--paper { stroke: var(--color-white); }
  .concept--on-dark .control-halo, .concept--on-dark .outcome, .concept--on-dark .output-card { fill: rgba(121, 215, 219, 0.12); }
  .concept--on-dark .control-ring, .concept--on-dark .control-ring-inner, .concept--on-dark .hub-inner, .concept--on-dark .outcome { stroke: #79d7db; }
  .concept--on-dark .output-card { stroke: #79d7db; }
  .concept--on-dark .label, .concept--on-dark .callout, .concept--on-dark .center-label, .concept--on-dark .stage-label, .concept--on-dark .workflow-label, .concept--on-dark .output-label, .concept--on-dark .output-detail { fill: var(--color-white); }
  .concept__mobile-summary { display: none; }
  @media (max-width: 760px) {
    .concept__desktop-art { display: none; }
    .concept__mobile-summary { display: grid; gap: 0.7rem; padding: 0; margin: 0; list-style: none; }
    .concept__mobile-summary li { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 0.8rem; align-items: center; min-width: 0; color: var(--color-ink); font-weight: 750; }
    .concept__mobile-summary li > span:first-child { width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; border: 2px solid var(--color-teal); border-radius: 50%; color: var(--color-navy); font-size: 0.85rem; }
    .concept--on-dark .concept__mobile-summary li { color: var(--color-white); }
    .concept--on-dark .concept__mobile-summary li > span:first-child { border-color: #79d7db; color: var(--color-white); }
  }
</style>
