---
import { primaryNavigation } from "../data/navigation";
import { bookingHref, bookingLinkAttributes } from "../lib/booking";
import { localPath } from "../lib/urls";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="logo-link" href={localPath("/")} aria-label="SeavicAI home" aria-current={isActive("/") ? "page" : undefined}>
      <img src={localPath("/brand/seavic-ai-consulting-horizontal.svg")} alt="SeavicAI Consulting" width="248" height="72" />
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {primaryNavigation.map((item) => (
        <a href={localPath(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
    <a class="header-cta" href={bookingHref} {...bookingLinkAttributes}>Book a SeaVic Discovery Call</a>
    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        {primaryNavigation.map((item) => (
          <a href={localPath(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
        ))}
        <a class="mobile-nav__cta" href={bookingHref} {...bookingLinkAttributes}>Book a SeaVic Discovery Call</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
  }

  .site-header__inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .logo-link img {
    width: clamp(170px, 18vw, 248px);
    height: auto;
    display: block;
  }

  .desktop-nav {
    display: flex;
    flex: 1;
    justify-content: center;
    gap: clamp(1rem, 1.8vw, 1.65rem);
    align-items: center;
    min-width: 0;
    padding-inline: clamp(0.5rem, 1vw, 1.25rem);
  }

  .desktop-nav a {
    position: relative;
    max-width: 190px;
    color: var(--color-ink);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: var(--color-teal);
  }

  .desktop-nav a[aria-current="page"]::after {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.55rem;
    height: 2px;
    background: var(--color-teal);
    content: "";
  }

  .header-cta {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 178px;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--color-navy);
    border-radius: var(--radius);
    background: var(--color-navy);
    color: var(--color-white);
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }

  .header-cta:hover {
    background: #14293e;
    color: var(--color-white);
  }

  .mobile-nav {
    display: none;
    margin-left: auto;
  }

  .mobile-nav summary {
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-navy);
    cursor: pointer;
    font-weight: 800;
  }

  .mobile-nav nav {
    position: absolute;
    left: 1rem;
    right: 1rem;
    top: 70px;
    display: grid;
    gap: 0.2rem;
    padding: 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: var(--shadow-soft);
  }

  .mobile-nav a {
    padding: 0.85rem;
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: none;
  }

  .mobile-nav a[aria-current="page"] {
    color: var(--color-teal);
  }

  .mobile-nav__cta {
    border-radius: var(--radius);
    background: var(--color-navy);
    color: var(--color-white) !important;
    text-align: center;
  }

  @media (max-width: 1120px) {
    .desktop-nav,
    .header-cta {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }
</style>
