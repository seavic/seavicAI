---
import { primaryNavigation } from "../data/navigation";
import { siteConfig } from "../data/siteConfig";
import { localPath } from "../lib/urls";
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="wordmark" href={localPath("/")} aria-label="SeavicAI home">
      <span class="wordmark__main">Seavic<span>AI</span></span>
      <span class="wordmark__sub">CONSULTING</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {primaryNavigation.map((item) => <a href={localPath(item.href)}>{item.label}</a>)}
    </nav>
    <a class="header-cta" href={localPath("/contact/")}>{siteConfig.marketingDomain}</a>
    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        {primaryNavigation.map((item) => <a href={localPath(item.href)}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.96);
  }

  .site-header__inner {
    min-height: 78px;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .wordmark {
    display: inline-flex;
    flex-direction: column;
    min-width: 132px;
    color: var(--color-navy);
    text-decoration: none;
    line-height: 1;
  }

  .wordmark__main {
    font-size: 1.38rem;
    font-weight: 800;
  }

  .wordmark__main span,
  .wordmark__sub {
    color: var(--color-teal);
  }

  .wordmark__sub {
    margin-top: 0.18rem;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.22em;
  }

  .desktop-nav {
    display: flex;
    flex: 1;
    justify-content: center;
    gap: 0.55rem;
    align-items: center;
  }

  .desktop-nav a {
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  .desktop-nav a:hover {
    color: var(--color-teal);
  }

  .header-cta {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-navy);
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
  }

  .mobile-nav {
    display: none;
    margin-left: auto;
  }

  .mobile-nav summary {
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-navy);
    cursor: pointer;
    font-weight: 800;
  }

  .mobile-nav nav {
    position: absolute;
    left: 1rem;
    right: 1rem;
    top: 70px;
    display: grid;
    gap: 0.2rem;
    padding: 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: var(--shadow-soft);
  }

  .mobile-nav a {
    padding: 0.85rem;
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 1120px) {
    .desktop-nav,
    .header-cta {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }
</style>
