---
import ConceptDiagram from "./ConceptDiagram.astro";
import { localPath } from "../lib/urls";

interface Props {
  eyebrow?: string;
  title: string;
  lead: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  showVisual?: boolean;
  visualVariant?: "hero-control" | "risk-evidence" | "management" | "workflow" | "about" | "contact";
  size?: "default" | "compact";
}

const {
  eyebrow,
  title,
  lead,
  primaryHref = "/contact/",
  primaryLabel = "Book a SeaVic Discovery Call",
  secondaryHref = "/how-we-work/",
  secondaryLabel = "See How We Work",
  showVisual = true,
  visualVariant = "hero-control",
  size = "default"
} = Astro.props;

const heroClass = [
  "hero",
  "section",
  !showVisual && "hero--solo",
  size === "compact" && "hero--compact"
].filter(Boolean).join(" ");
---

<section class={heroClass}>
  <div class="container hero__grid">
    <div class="hero__copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      <div class="button-row">
        <a class="button" href={localPath(primaryHref)}>{primaryLabel}</a>
        <a class="button button--secondary" href={localPath(secondaryHref)}>{secondaryLabel}</a>
      </div>
    </div>
    {showVisual && (
      <div class={`hero__visual ${visualVariant === "hero-control" ? "hero__visual--control" : "visual-panel"}`}>
        <ConceptDiagram variant={visualVariant} title="Conceptual advisory diagram showing AI activity moving into visibility, governance and control" />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-navy);
    color: var(--color-white);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .hero__copy {
    max-width: 900px;
  }

  .hero__copy h1 {
    margin-bottom: 1rem;
    color: var(--color-white);
    font-size: clamp(3rem, 5vw, 4.5rem);
  }

  .hero__copy .lead,
  .hero__copy p {
    color: #dce8ea;
  }

  .hero--solo .hero__grid {
    grid-template-columns: 1fr;
  }

  .hero--solo .hero__copy {
    max-width: 980px;
  }

  .hero--compact .hero__copy h1 {
    font-size: clamp(2.4rem, 4vw, 3.4rem);
  }

  .hero__copy .lead {
    margin-bottom: 1.5rem;
  }

  .hero .button {
    border-color: var(--color-white);
    background: var(--color-white);
    color: var(--color-navy);
  }

  .hero .button:hover {
    background: var(--color-blue-gray);
    color: var(--color-navy);
  }

  .hero .button--secondary {
    background: transparent;
    color: var(--color-white);
  }

  .hero .button--secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-white);
  }

  .hero__visual {
    min-height: 280px;
    display: flex;
    align-items: center;
  }

  .hero__visual--control {
    min-height: 350px;
    padding: 0.5rem 0;
  }

  .hero__visual :global(.concept__flow::before) {
    background: rgba(255, 255, 255, 0.28);
  }

  @media (max-width: 920px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      min-height: auto;
    }
  }
</style>
