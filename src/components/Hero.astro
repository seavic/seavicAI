---
import { localPath } from "../lib/urls";

interface Props {
  eyebrow?: string;
  title: string;
  lead: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  showVisual?: boolean;
  size?: "default" | "compact";
}

const {
  eyebrow,
  title,
  lead,
  primaryHref = "/contact/",
  primaryLabel = "Book a SeaVic Discovery Call",
  secondaryHref = "/how-we-work/",
  secondaryLabel = "See How We Work",
  showVisual = true,
  size = "default"
} = Astro.props;

const heroClass = [
  "hero",
  "section",
  !showVisual && "hero--solo",
  size === "compact" && "hero--compact"
].filter(Boolean).join(" ");
---

<section class={heroClass}>
  <div class="container hero__grid">
    <div class="hero__copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      <div class="button-row">
        <a class="button" href={localPath(primaryHref)}>{primaryLabel}</a>
        <a class="button button--secondary" href={localPath(secondaryHref)}>{secondaryLabel}</a>
      </div>
    </div>
    {showVisual && (
      <div class="visual-panel hero__visual" aria-label="Enterprise AI control model diagram">
        <div class="control-map">
          <div class="control-map__row">
            <div class="control-map__label">Use</div>
            <div class="control-map__value">What AI is being used?</div>
          </div>
          <div class="control-map__row">
            <div class="control-map__label">Risk</div>
            <div class="control-map__value">What risk does it create?</div>
          </div>
          <div class="control-map__row">
            <div class="control-map__label">Ownership</div>
            <div class="control-map__value">Who owns it?</div>
          </div>
          <div class="control-map__row">
            <div class="control-map__label">Cost</div>
            <div class="control-map__value">What does it cost?</div>
          </div>
          <div class="control-map__row">
            <div class="control-map__label">Value</div>
            <div class="control-map__value">Does it create enough value to scale?</div>
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--color-border);
    background:
      linear-gradient(180deg, #ffffff 0%, #f8fbfb 100%);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .hero__copy {
    max-width: 900px;
  }

  .hero__copy h1 {
    margin-bottom: 1rem;
  }

  .hero--solo .hero__grid {
    grid-template-columns: 1fr;
  }

  .hero--solo .hero__copy {
    max-width: 980px;
  }

  .hero--compact .hero__copy h1 {
    font-size: clamp(2.15rem, 4vw, 3.75rem);
  }

  .hero__copy .lead {
    margin-bottom: 1.5rem;
  }

  .hero__visual {
    min-height: 360px;
    display: flex;
    align-items: center;
  }

  @media (max-width: 920px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      min-height: auto;
    }
  }
</style>
