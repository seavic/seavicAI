---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<div class="section-heading">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</div>

<style>
  .section-heading {
    max-width: 860px;
    margin-bottom: 2rem;
  }
</style>
