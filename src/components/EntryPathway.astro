---
const steps = [
  "AI Control Diagnostic",
  "AI Governance, Risk and Compliance Readiness",
  "Security visibility and remediation planning",
  "Kosmoy platform-enabled management layer",
  "Managed AI Governance and transformation support"
];
---

<div class="entry-pathway">
  {steps.map((step, index) => (
    <div class="entry-pathway__step">
      <span>{index + 1}</span>
      <p>{step}</p>
    </div>
  ))}
</div>

<style>
  .entry-pathway {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .entry-pathway__step {
    min-height: 130px;
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
  }

  .entry-pathway span {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-teal);
    color: var(--color-white);
    font-weight: 800;
  }

  .entry-pathway p {
    margin: 0;
    color: var(--color-ink);
    font-weight: 700;
  }

  @media (max-width: 980px) {
    .entry-pathway {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .entry-pathway {
      grid-template-columns: 1fr;
    }
  }
</style>
