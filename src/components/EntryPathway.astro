---
import { entryPathway } from "../data/content";
---

<div class="entry-pathway">
  {entryPathway.map((step, index) => (
    <div class="entry-pathway__step">
      <span>{index + 1}</span>
      <p>{step}</p>
    </div>
  ))}
</div>

<style>
  .entry-pathway {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.25rem);
  }

  .entry-pathway::before {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 20px;
    height: 1px;
    background: var(--color-border);
    content: "";
  }

  .entry-pathway__step {
    position: relative;
    min-height: 130px;
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
  }

  .entry-pathway span {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-teal);
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-navy);
    font-weight: 800;
  }

  .entry-pathway p {
    margin: 0;
    color: var(--color-ink);
    font-weight: 700;
  }

  @media (max-width: 980px) {
    .entry-pathway {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .entry-pathway {
      grid-template-columns: 1fr;
    }

    .entry-pathway::before {
      left: 20px;
      right: auto;
      top: 8px;
      bottom: 8px;
      width: 1px;
      height: auto;
    }
  }
</style>
