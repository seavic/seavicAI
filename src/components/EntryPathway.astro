---
import { entryPathway } from "../data/content";
---

<ol class="entry-pathway" aria-label="SeaVic entry pathway overview">
  {entryPathway.map((step, index) => (
    <li>
      <span>{String(index + 1).padStart(2, "0")}</span>
      <p>{step}</p>
    </li>
  ))}
</ol>

<style>
  .entry-pathway { position: relative; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(0.75rem, 1.5vw, 1.25rem); padding: 0; margin: 0; list-style: none; }
  .entry-pathway::before { position: absolute; left: 10%; right: 10%; top: 20px; height: 2px; background: var(--color-teal); opacity: 0.5; content: ""; }
  .entry-pathway li { position: relative; display: grid; justify-items: center; gap: 0.7rem; min-width: 0; text-align: center; }
  .entry-pathway span { position: relative; z-index: 1; width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; border: 2px solid var(--color-teal); border-radius: 50%; background: var(--color-white); color: var(--color-navy); font-weight: 800; }
  .entry-pathway p { min-height: 3em; margin: 0; color: var(--color-ink); font-size: 0.94rem; font-weight: 700; line-height: 1.35; }
  @media (max-width: 1180px) and (min-width: 761px) {
    .entry-pathway { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 1.5rem; }
    .entry-pathway::before { display: none; }
    .entry-pathway li:nth-child(5) { grid-column: 2; }
  }
  @media (max-width: 760px) {
    .entry-pathway { grid-template-columns: 1fr; gap: 0.75rem; }
    .entry-pathway::before { left: 19px; right: auto; top: 20px; bottom: 20px; width: 2px; height: auto; }
    .entry-pathway li { grid-template-columns: 40px minmax(0, 1fr); justify-items: start; align-items: center; text-align: left; }
    .entry-pathway p { min-height: auto; font-size: 0.98rem; }
  }
</style>
