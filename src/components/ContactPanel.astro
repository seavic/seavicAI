---
import { siteConfig } from "../data/siteConfig";
import { bookingHref, bookingLinkAttributes } from "../lib/booking";
---

<div class="contact-panel card">
  <div class="card__body">
    <p class="eyebrow">Contact</p>
    <h3>Book a SeaVic Discovery Call.</h3>
    <p>
      Send a short note about the AI decision, operating issue or governance question you want to clarify.
      Please do not include confidential, regulated or sensitive information.
    </p>
    <p><a class="button" href={bookingHref} {...bookingLinkAttributes}>Book a SeaVic Discovery Call</a></p>
    <p><a href={`mailto:${siteConfig.contactEmail}`}>Email {siteConfig.contactEmail}</a></p>
  </div>
</div>

<style>
  .contact-panel h3 {
    margin-bottom: 0.75rem;
  }

  .small {
    margin-top: 1rem;
    font-size: 0.9rem;
  }
</style>
