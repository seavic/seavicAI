---
import { siteConfig } from "../data/siteConfig";
---

<div class="contact-panel card">
  <div class="card__body">
    <p class="eyebrow">Contact</p>
    <h3>Begin with a focused conversation.</h3>
    <p>
      Send a short note about the AI priority, operating question or governance concern you want to clarify.
      Please do not include confidential, regulated or sensitive information.
    </p>
    <p><a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a></p>
    {
      siteConfig.flags.enableBookingLink && siteConfig.bookingUrl && (
        <a class="button" href={siteConfig.bookingUrl}>Schedule a conversation</a>
      )
    }
    {
      !siteConfig.flags.enableContactForm && (
        <p class="small">The contact form is disabled until the provider and privacy treatment are approved.</p>
      )
    }
  </div>
</div>

<style>
  .contact-panel h3 {
    margin-bottom: 0.75rem;
  }

  .small {
    margin-top: 1rem;
    font-size: 0.9rem;
  }
</style>
