---
import { localPath } from "../lib/urls";

interface Props {
  title?: string;
  lead?: string;
}

const {
  title = "Start with the AI decision or operating issue in front of you.",
  lead = "A SeaVic Discovery Call is a focused conversation about what is happening, what leadership needs to decide and whether there is a useful next step for SeaVic to support."
} = Astro.props;
---

<section class="section section--navy">
  <div class="container cta">
    <div>
      <p class="eyebrow">Next step</p>
      <h2>{title}</h2>
      <p class="lead">{lead}</p>
    </div>
    <div class="button-row">
      <a class="button button--secondary" href={localPath("/contact/")}>Book a SeaVic Discovery Call</a>
      <a class="button" href={localPath("/how-we-work/")}>See How We Work</a>
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.55fr);
    gap: 2rem;
    align-items: center;
  }

  .cta .button {
    border-color: var(--color-white);
  }

  @media (max-width: 780px) {
    .cta {
      grid-template-columns: 1fr;
    }
  }
</style>
