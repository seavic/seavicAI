---
import { methodSteps } from "../data/content";
---

<ol class="methodology" aria-label="SeaVic five-stage engagement pathway">
  {methodSteps.map((step, index) => (
    <li>
      <span class="methodology__marker">{String(index + 1).padStart(2, "0")}</span>
      <div class="methodology__content">
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .methodology { position: relative; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(0.75rem, 1.5vw, 1.25rem); padding: 0; margin: 0; list-style: none; }
  .methodology::before { position: absolute; z-index: 0; left: 10%; right: 10%; top: 21px; height: 2px; background: var(--color-teal); opacity: 0.55; content: ""; }
  .methodology li { position: relative; z-index: 1; display: grid; grid-template-rows: 42px auto; gap: 1rem; min-width: 0; }
  .methodology__marker { width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; justify-self: center; border: 2px solid var(--color-teal); border-radius: 50%; background: var(--color-white); color: var(--color-navy); font-weight: 800; line-height: 1; }
  .methodology__content { display: grid; align-content: start; min-height: 202px; padding: 1.15rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-white); box-shadow: var(--shadow-soft); }
  .methodology h3 { min-height: 3.25em; margin: 0 0 0.7rem; font-size: 1.12rem; line-height: 1.2; }
  .methodology p { margin: 0; font-size: 0.94rem; line-height: 1.5; }
  @media (max-width: 1180px) and (min-width: 761px) {
    .methodology { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 1.75rem; }
    .methodology::before { display: none; }
    .methodology li:nth-child(4) { grid-column: 1 / span 1; }
    .methodology li:nth-child(5) { grid-column: 2 / span 1; }
    .methodology__content { min-height: 176px; }
  }
  @media (max-width: 760px) {
    .methodology { grid-template-columns: 1fr; gap: 0.85rem; }
    .methodology::before { left: 20px; right: auto; top: 21px; bottom: 21px; width: 2px; height: auto; }
    .methodology li { grid-template-columns: 42px minmax(0, 1fr); grid-template-rows: auto; align-items: start; gap: 1rem; }
    .methodology__marker { justify-self: start; }
    .methodology__content { min-height: 0; }
    .methodology h3 { min-height: auto; }
  }
</style>
